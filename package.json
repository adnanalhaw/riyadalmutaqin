{
  "name": "riyad-almutaqin",
  "version": "0.1.0",
  "private": true,
  "description": "منصة رياض المتقين — منصة دعوية على Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply riyad_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply riyad_db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.95.0"
  }
}
